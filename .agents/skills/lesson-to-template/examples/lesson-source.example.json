    {
      "module": "Модуль 1. Кто такой мастер",
      "lesson": "Урок 1.4. Авторитет мастера",
      "sourceSlide": 15,
      "title": "Слайд 15. Просьба и задача",
      "authorType": null,
      "interactive": false,
      "blocks": [
        {
          "kind": "paragraph",
          "body_index": 431,
          "text": "Просьба коллеги",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "subhead"
        },
        {
          "kind": "paragraph",
          "body_index": 432,
          "text": "«Сделаешь, когда сможешь».",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "quote"
        },
        {
          "kind": "paragraph",
          "body_index": 433,
          "text": "Человек сам определит, насколько просьба срочная и когда её выполнить.",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "text"
        },
        {
          "kind": "paragraph",
          "body_index": 434,
          "text": "Задача мастера",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "subhead"
        },
        {
          "kind": "paragraph",
          "body_index": 435,
          "text": "«Сделай заказ до 12:00. Сейчас он первый по приоритету. Если не хватает деталей, сообщи сразу. В 10:30 я проверю, как идёт работа».",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "quote"
        },
        {
          "kind": "paragraph",
          "body_index": 436,
          "text": "В задаче обозначены:",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": false,
          "list_level": null,
          "flags": [],
          "role": "text"
        },
        {
          "kind": "paragraph",
          "body_index": 437,
          "text": "приоритет;",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": true,
          "list_level": 0,
          "flags": [],
          "role": "item"
        },
        {
          "kind": "paragraph",
          "body_index": 438,
          "text": "срок;",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": true,
          "list_level": 0,
          "flags": [],
          "role": "item"
        },
        {
          "kind": "paragraph",
          "body_index": 439,
          "text": "действие при сбое;",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": true,
          "list_level": 0,
          "flags": [],
          "role": "item"
        },
        {
          "kind": "paragraph",
          "body_index": 440,
          "text": "контроль.",
          "style": "Normal (Web)",
          "bold": false,
          "numbered": true,
          "list_level": 0,
          "flags": [],
          "role": "item"
        }
      ],
      "summary": {
